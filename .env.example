# ── Required ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# GitHub OAuth (for private repo access)
GITHUB_ID=your-github-oauth-client-id
GITHUB_SECRET=your-github-oauth-client-secret

# Separate GitHub OAuth App for private repo (repo scope)
# Create at: github.com/settings/developers → OAuth Apps → New OAuth App
NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/github-callback
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/github-callback

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── AI Provider (at least one required) ──
# Primary: OpenRouter (recommended — configured chat model, 1M context)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Fallback: Groq (free tier, limited TPM)
GROQ_API_KEY=gsk_your-key-here

# ── Environment ──
# Controls Sentry reporting.
# "dev"  = Sentry silent.
# "prod" = Sentry active.
# Set to "prod" locally to test Sentry without deploying.
NEXT_PUBLIC_APP_ENV=dev

# ── Sentry ──
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Stripe (billing) ──
# Get these from dashboard.stripe.com → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
# Create products+prices in Stripe dashboard → each ID starts with price_
STRIPE_PRO_PRICE_ID=price_your-pro-id
STRIPE_TEAM_PRICE_ID=price_your-team-id

# ── Admin ──
# Secret key for admin endpoints (pre-indexing, etc.)
# Generate with: openssl rand -hex 32
ADMIN_SECRET=replace-with-a-random-secret

# ── Upstash Redis (rate limiting & caching) ──
# Create a free database at console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── Resend (transactional email) ──
# Free tier: 3000 emails/month. Sign up at resend.com
RESEND_API_KEY=re_your-key
RESEND_FROM_EMAIL=Vibo <notifications@yourdomain.com>

# ── PostHog (product analytics) ──
# Free tier: 1M events/month. Sign up at posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_your-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── CheckDisposable Email (disposable email blocking) ──
# Free tier: 500 checks/month. Sign up at app.checkdisposable.email/signup
CDE_KEY=cde_live_your-key
